---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectImage from '../../components/ProjectImage.astro';
import { projects, type Project } from '../../data/projects';
export function getStaticPaths() { return projects.map(project => ({ params: { id: project.id }, props: { project } })); }
const { project } = Astro.props as { project: Project };
---
<BaseLayout title={`${project.title} : réalisation d’un site vitrine`} description={project.desc}>
  <section class="page-hero case-hero">
    <div class="container">
      <a href="/Projets" class="back-link">← Toutes les réalisations</a>
      <p class="section-pre mono-font fire-text">- Site vitrine · artisan peintre</p>
      <h1 class="display-font page-title">Moment <span class="fire-text">D. Art</span></h1>
      <p class="page-sub">{project.desc}</p>
      <a href={project.url} target="_blank" rel="noopener noreferrer" class="btn-fire">Visiter momentdart.be ↗</a>
    </div>
  </section>
  <section class="section case-overview">
    <div class="container case-columns">
      <div><h2 class="display-font">Le besoin</h2><p>{project.brief}</p><h2 class="display-font">L’approche</h2><p>{project.approach}</p></div>
      <div class="case-delivered card"><p class="section-pre mono-font fire-text">- Ce qui a été réalisé</p><ul>{project.delivered.map(item => <li>{item}</li>)}</ul><p class="case-stack">{project.stack.join(' · ')}</p></div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <p class="section-pre mono-font fire-text">- En images</p><h2 class="display-font gallery-title">Le site, de plus près</h2>
      <div class="case-gallery">
        {project.photos.map((photo, index) => <a class="gallery-image" href={project.url} target="_blank" rel="noopener noreferrer" aria-label="Voir le site Moment D. Art en ligne"><ProjectImage source={photo} alt={project.photoDescriptions[index]} loading={index === 0 ? 'eager' : 'lazy'} /></a>)}
      </div>
    </div>
  </section>
  <section class="section"><div class="container case-next card"><h2 class="display-font">Un site pour votre activité ?</h2><p>Partez de vos besoins et découvrez le budget de votre projet.</p><a href="/Sites-web#configurateur" class="btn-fire">Configurer mon site</a></div></section>
</BaseLayout>
<style>
.back-link { display: inline-block; margin-bottom: 2rem; color: var(--text-muted); }
.case-hero .page-sub { max-width: 65ch; }
.case-overview { border-block: 1px solid var(--dark-border); background: var(--dark-card); }
.case-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
.case-columns h2 { font-size: 2.2rem; margin-bottom: .8rem; }
.case-columns h2:not(:first-child) { margin-top: 2rem; }
.case-columns p { color: var(--text-secondary); line-height: 1.8; }
.case-delivered { padding: 2rem; }
.case-delivered ul { list-style: none; display: grid; gap: 1rem; margin-top: 1rem; }
.case-delivered li { border-left: 2px solid var(--ember-2); padding-left: .8rem; }
.case-stack { margin-top: 1.5rem; font-size: .85rem; color: var(--text-muted); }
.gallery-title { font-size: 3rem; margin-bottom: 2rem; }
.case-gallery { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
.gallery-image { display: block; overflow: hidden; border: 1px solid var(--dark-border-2); background: var(--dark-card); transition: border-color .2s; }
.gallery-image:hover { border-color: var(--ember-2); }
.gallery-image :global(img) { display: block; width: 100%; height: auto; }
.case-next { padding: 2.5rem; text-align: center; }
.case-next h2 { font-size: clamp(2rem,4vw,3rem); }
.case-next p { color: var(--text-secondary); margin: 1rem 0 1.5rem; }
@media (max-width: 768px) { .case-columns, .case-gallery { grid-template-columns: 1fr; gap: 1.5rem; } }
</style>
