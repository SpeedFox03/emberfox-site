---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlobeLight from 'phosphor-astro/GlobeLight.astro';
import LightningLight from 'phosphor-astro/LightningLight.astro';
import DesktopLight from 'phosphor-astro/DesktopLight.astro';
import WrenchLight from 'phosphor-astro/WrenchLight.astro';
import ChatLight from 'phosphor-astro/ChatLight.astro';
import ArrowRightLight from 'phosphor-astro/ArrowRightLight.astro';

const projectTypes = [
  {
    icon: GlobeLight,
    number: '01',
    title: 'Site web',
    description: 'Landing page, site vitrine ou boutique en ligne avec accompagnement mensuel.',
    href: '/Sites-web#configurateur',
    action: 'Configurer mon site',
    highlight: true,
  },
  {
    icon: LightningLight,
    number: '02',
    title: 'Application',
    description: 'Application métier, outil interne ou solution mobile adaptée à votre façon de travailler.',
    href: '/Contact?service=Application%20sur%20mesure',
    action: 'Présenter mon besoin',
  },
  {
    icon: DesktopLight,
    number: '03',
    title: 'Montage PC',
    description: 'Configuration gaming, création ou professionnelle pensée selon votre budget.',
    href: '/Contact?service=Montage%20PC',
    action: 'Configurer mon PC',
  },
  {
    icon: WrenchLight,
    number: '04',
    title: 'Dépannage',
    description: 'Diagnostic, réparation ou intervention rapide à domicile et à distance.',
    href: '/Contact?service=D%C3%A9pannage%20%C3%A0%20domicile',
    action: 'Décrire mon problème',
  },
];
---

<BaseLayout title="Démarrer un projet" description="Choisissez le service Enkotech adapté à votre projet">
  <section class="project-start-hero">
    <div class="container project-start-intro">
      <p class="section-pre mono-font fire-text">— Démarrer un projet</p>
      <h1 class="display-font">Par quoi<br/><span class="fire-text">commençons-nous ?</span></h1>
      <p>Choisissez le type de projet qui vous correspond. Vous serez dirigé vers l’étape la plus utile, sans devoir tout réexpliquer.</p>
    </div>
  </section>

  <section class="project-picker-section">
    <div class="container">
      <div class="project-picker-grid">
        {projectTypes.map(project => (
          <a href={project.href} class={`project-choice ${project.highlight ? 'project-choice-highlight' : ''}`}>
            <div class="project-choice-top">
              <span class="project-choice-icon"><project.icon width={30} height={30} /></span>
              <span class="project-choice-number mono-font">{project.number}</span>
            </div>
            <div>
              <h2 class="display-font">{project.title}</h2>
              <p>{project.description}</p>
            </div>
            <span class="project-choice-action display-font">
              {project.action}
              <ArrowRightLight width={18} height={18} />
            </span>
          </a>
        ))}
      </div>

      <div class="other-project">
        <div class="other-project-copy">
          <span class="other-project-icon"><ChatLight width={24} height={24} /></span>
          <div>
            <h2 class="display-font">Une autre demande ?</h2>
            <p>Une question, un besoin particulier ou simplement envie d’en discuter ? Utilisez le formulaire classique.</p>
          </div>
        </div>
        <a href="/Contact" class="btn-outline">
          Formulaire de contact
          <ArrowRightLight width={17} height={17} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.project-start-hero { padding: 10rem 0 3.5rem; position: relative; overflow: hidden; }
.project-start-hero::after {
  content: '';
  position: absolute;
  width: 560px;
  height: 360px;
  right: -120px;
  top: 20px;
  background: radial-gradient(ellipse, rgba(255, 90, 0, 0.09), transparent 68%);
  pointer-events: none;
}
.project-start-intro { position: relative; z-index: 1; }
.project-start-intro h1 { font-size: clamp(3.7rem, 7vw, 6.5rem); line-height: 0.9; max-width: 820px; margin: 1rem 0 1.5rem; }
.project-start-intro > p:last-child { color: var(--text-secondary); max-width: 650px; font-size: 1.05rem; line-height: 1.8; }
.project-picker-section { padding: 2rem 0 7rem; }
.project-picker-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
.project-choice {
  min-width: 0;
  min-height: 300px;
  padding: 2rem;
  display: flex;
  flex-direction: column;
  gap: 2rem;
  color: inherit;
  text-decoration: none;
  background: var(--dark-card);
  border: 1px solid var(--dark-border);
  clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 18px 100%, 0 calc(100% - 18px));
  transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
}
.project-choice:hover { transform: translateY(-4px); border-color: rgba(255, 107, 0, 0.55); background: var(--dark-card-2); }
.project-choice-highlight { border-color: rgba(255, 107, 0, 0.48); }
.project-choice-highlight::before {
  content: 'CONFIGURATEUR DISPONIBLE';
  position: absolute;
  top: 0;
  right: 0;
  padding: 0.35rem 0.75rem;
  color: #080604;
  background: var(--gradient-fire);
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.6rem;
  letter-spacing: 0.1em;
}
.project-choice { position: relative; }
.project-choice-top { display: flex; align-items: flex-start; justify-content: space-between; }
.project-choice-icon { color: var(--ember-2); display: flex; }
.project-choice-number { color: var(--text-muted); font-size: 0.75rem; }
.project-choice h2 { font-size: 2rem; color: var(--text-primary); margin-bottom: 0.55rem; }
.project-choice p { color: var(--text-secondary); line-height: 1.7; max-width: 44ch; }
.project-choice-action { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--ember-3); letter-spacing: 0.1em; margin-top: auto; }
.project-choice-action svg { transition: transform 0.2s ease; }
.project-choice:hover .project-choice-action svg { transform: translateX(5px); }
.other-project {
  margin-top: 1rem;
  padding: 1.5rem 2rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  border: 1px solid var(--dark-border);
  background: rgba(255, 255, 255, 0.015);
}
.other-project-copy { display: flex; align-items: center; gap: 1rem; min-width: 0; }
.other-project-icon { display: flex; color: var(--ember-3); flex-shrink: 0; }
.other-project h2 { color: var(--text-primary); font-size: 1.45rem; }
.other-project p { color: var(--text-secondary); font-size: 0.85rem; }
.other-project .btn-outline { flex-shrink: 0; }

@media (max-width: 768px) {
  .project-start-hero { padding: 7.5rem 0 2.5rem; }
  .project-start-intro h1 { font-size: clamp(3rem, 13vw, 4.75rem); }
  .project-picker-section { padding: 1rem 0 5rem; }
  .project-picker-grid { grid-template-columns: 1fr; }
  .project-choice { min-height: 250px; }
  .other-project { align-items: flex-start; flex-direction: column; }
  .other-project .btn-outline { width: 100%; justify-content: center; }
}

@media (max-width: 480px) {
  .project-start-hero { padding: 6.5rem 0 2rem; }
  .project-start-intro h1 { font-size: clamp(2.8rem, 14vw, 4rem); }
  .project-start-intro > p:last-child { font-size: 0.95rem; line-height: 1.65; }
  .project-choice { min-height: 0; padding: 1.35rem; gap: 1.5rem; }
  .project-choice-highlight { padding-top: 2.3rem; }
  .project-choice h2 { font-size: 1.7rem; }
  .project-choice p { font-size: 0.9rem; }
  .project-choice-action { font-size: 1rem; }
  .other-project { padding: 1.25rem; }
  .other-project-copy { align-items: flex-start; }
}

@media (hover: none) {
  .project-choice:hover { transform: none; }
}
</style>

