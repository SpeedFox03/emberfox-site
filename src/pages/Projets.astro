---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectImage from '../components/ProjectImage.astro';
import { projects } from '../data/projects';
const project = projects[0];
---
<BaseLayout title="Projets" description="Découvrez Moment D. Art, un site vitrine réalisé par Enkotech pour un artisan peintre. Structure, prestations et demande de devis.">
  <section class="page-hero">
    <div class="container">
      <p class="section-pre mono-font fire-text">- Réalisation web</p>
      <h1 class="display-font page-title">Du concret.<br/><span class="fire-text">À découvrir.</span></h1>
      <p class="page-sub">Un aperçu du travail réalisé, avec le site en ligne et les choix qui ont guidé sa conception.</p>
    </div>
  </section>
  <section class="section project-feature">
    <div class="container project-case-grid">
      <a class="project-preview" href="/Projets/moment-d-art" aria-label="Découvrir le projet Moment D. Art">
        <div class="preview-bar mono-font"><span aria-hidden="true">● ● ●</span><span>momentdart.be</span></div>
        <ProjectImage source={project.photos[0]} alt="Aperçu du site vitrine Moment D. Art, artisan peintre" loading="eager" />
      </a>
      <div class="project-case-copy">
        <p class="section-pre mono-font fire-text">- Artisanat & création web</p>
        <h2 class="display-font">{project.title}</h2>
        <p>{project.desc}</p>
        <ul>{project.delivered.slice(0, 4).map(item => <li>{item}</li>)}</ul>
        <div class="case-actions"><a class="btn-fire" href="/Projets/moment-d-art">Découvrir le projet</a><a class="btn-outline" href={project.url} target="_blank" rel="noopener noreferrer">Voir le site ↗</a></div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container project-invitation card">
      <div><p class="section-pre mono-font fire-text">- Votre activité mérite sa place</p><h2 class="display-font">Et votre site ?</h2><p>Choisissez une formule et les options utiles à votre activité. Vous obtenez une estimation avant de prendre contact.</p></div>
      <a href="/Sites-web#configurateur" class="btn-fire">Configurer mon site</a>
    </div>
  </section>
</BaseLayout>
<style>
.project-feature { border-block: 1px solid var(--dark-border); background: var(--dark-card); }
.project-case-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 3rem; align-items: center; }
.project-preview { display: block; background: var(--dark-bg); border: 1px solid var(--dark-border-2); overflow: hidden; }
.preview-bar { display: flex; justify-content: space-between; padding: .8rem 1rem; color: var(--text-muted); font-size: .8rem; border-bottom: 1px solid var(--dark-border); }
.preview-bar span:first-child { color: var(--ember-2); letter-spacing: .2rem; }
.project-preview :global(img) { display: block; width: 100%; height: auto; }
.project-case-copy h2 { font-size: clamp(2.7rem,5vw,4rem); margin-bottom: 1rem; }
.project-case-copy p:not(.section-pre), .project-invitation p:not(.section-pre) { color: var(--text-secondary); line-height: 1.8; }
.project-case-copy ul { list-style: none; display: grid; gap: .7rem; margin: 1.5rem 0; }
.project-case-copy li { border-left: 2px solid var(--ember-2); padding-left: .8rem; color: var(--text-secondary); }
.case-actions { display: flex; gap: .8rem; flex-wrap: wrap; }
.project-invitation { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: 2.5rem; }
.project-invitation h2 { font-size: 3rem; margin-bottom: .8rem; }
.project-invitation p { max-width: 55ch; }
.project-invitation a { flex-shrink: 0; }
@media (max-width: 900px) { .project-case-grid { grid-template-columns: 1fr; gap: 2rem; } .project-invitation { flex-direction: column; align-items: flex-start; } }
</style>
