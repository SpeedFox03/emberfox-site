---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CheckCircleLight from 'phosphor-astro/CheckCircleLight.astro';
import ArrowRightLight from 'phosphor-astro/ArrowRightLight.astro';
import PaperPlaneTiltLight from 'phosphor-astro/PaperPlaneTiltLight.astro';

const offers = [
  {
    id: 'landing', title: 'Landing page', kicker: 'Pour lancer une offre',
    launch: 150, monthly: 75, purchase: 600,
    features: ['Une page sur mesure', 'Hébergement & maintenance', 'SEO essentiel', 'Formulaire de contact', '1 h de modifications / mois', 'Refonte offerte après 5 ans'],
    quantity: { label: 'Sections supplémentaires', unit: 'section', monthly: 5, purchase: 50, max: 8 },
    options: [
      { id: 'seo-local', label: 'SEO local renforcé', desc: 'Structure, mots-clés et fiche locale', setup: 250, monthly: 0 },
      { id: 'copywriting', label: 'Rédaction des contenus', desc: 'Textes de vente optimisés pour convertir', setup: 120, monthly: 0 },
      { id: 'booking', label: 'Prise de rendez-vous', desc: 'Agenda et confirmation automatisée', setup: 100, monthly: 10 },
      { id: 'multilingual', label: 'Version bilingue', desc: 'Une langue supplémentaire', setup: 150, monthly: 15 },
    ],
  },
  {
    id: 'site', title: 'Site 4 pages', kicker: 'Pour présenter votre activité',
    launch: 250, monthly: 125, purchase: 1200, highlight: true,
    features: ['4 pages sur mesure', 'Hébergement, sécurité & sauvegardes', 'SEO essentiel', 'Formulaire & statistiques', '2 h de modifications / mois', 'Refonte offerte après 5 ans'],
    quantity: { label: 'Pages supplémentaires', unit: 'page', monthly: 10, purchase: 100, max: 20 },
    options: [
      { id: 'seo-complet', label: 'SEO approfondi', desc: 'Audit, recherche de mots-clés et optimisation', setup: 250, monthly: 0 },
      { id: 'blog', label: 'Blog administrable', desc: 'Publiez vos actualités en autonomie', setup: 150, monthly: 15 },
      { id: 'booking', label: 'Réservation en ligne', desc: 'Agenda, créneaux et confirmations', setup: 120, monthly: 10 },
      { id: 'multilingual', label: 'Version bilingue', desc: 'Une langue supplémentaire', setup: 250, monthly: 20 },
      { id: 'newsletter', label: 'Newsletter', desc: 'Inscription et outil d’envoi connecté', setup: 100, monthly: 10 },
    ],
  },
  {
    id: 'ecommerce', title: 'E-commerce', kicker: 'Pour vendre en ligne',
    launch: 500, monthly: 195, purchase: 2400,
    features: ['Boutique jusqu’à 20 produits', 'Paiement sécurisé', 'Commandes & stock', 'Hébergement & maintenance', '3 h de modifications / mois', 'Refonte offerte après 5 ans'],
    quantity: { label: 'Packs de 10 produits en plus', unit: 'pack', monthly: 12, purchase: 120, max: 20 },
    options: [
      { id: 'seo-shop', label: 'SEO e-commerce avancé', desc: 'Catégories, produits et données structurées', setup: 350, monthly: 0 },
      { id: 'catalog', label: 'Import du catalogue', desc: 'Reprise et nettoyage de vos produits', setup: 250, monthly: 0 },
      { id: 'shipping', label: 'Transporteurs connectés', desc: 'Tarifs, étiquettes et suivi automatisés', setup: 200, monthly: 15 },
      { id: 'multilingual', label: 'Boutique bilingue', desc: 'Une langue supplémentaire', setup: 300, monthly: 25 },
      { id: 'recovery', label: 'Relance des paniers abandonnés', desc: 'Scénario email automatisé', setup: 120, monthly: 15 },
    ],
  },
];

const techs = ['Astro', 'Next.js', 'WordPress', 'Shopify', 'Tailwind CSS', 'Figma', 'Vercel', 'Netlify'];

const processSteps: [string, string][] = [
  ['Brief',         "On discute de votre projet, vos besoins, votre cible et votre identité."],
  ['Maquette',      "Je conçois les wireframes et la charte graphique pour votre validation."],
  ['Développement', "Je code votre site avec les meilleures technologies du marché."],
  ['Livraison',     "Tests, mise en ligne, formation et suivi post-lancement."],
];
---
<BaseLayout title="Sites Web" description="Création de sites web professionnels sur mesure — Enkotech">

  <!-- HERO PAGE -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-inner">
        <p class="section-pre mono-font fire-text">— Service 01</p>
        <h1 class="display-font page-title">Sites<br/><span class="fire-text">Web</span></h1>
        <p class="page-sub">Des sites qui ne passent pas inaperçus. Du design au code, je crée des expériences web qui reflètent votre identité et convertissent vos visiteurs.</p>
        <a href="#configurateur" class="btn-fire">
          Demander un devis
          <ArrowRightLight width={16} height={16} />
        </a>
      </div>
    </div>
    <div class="page-deco-bg" aria-hidden="true">
      <svg viewBox="0 0 500 420" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <radialGradient id="wfGlow" cx="50%" cy="50%" r="55%">
            <stop offset="0%" stop-color="rgba(255,80,0,0.10)"/>
            <stop offset="100%" stop-color="rgba(255,60,0,0)"/>
          </radialGradient>
        </defs>
        <ellipse cx="250" cy="210" rx="210" ry="190" fill="url(#wfGlow)"/>
        <rect x="35" y="50" width="430" height="320" rx="5" stroke="rgba(255,130,0,0.18)" stroke-width="1.2" fill="none"/>
        <rect x="35" y="50" width="430" height="34" rx="5" stroke="rgba(255,130,0,0.16)" stroke-width="1" fill="rgba(255,80,0,0.04)"/>
        <line x1="35" y1="84" x2="465" y2="84" stroke="rgba(255,120,0,0.12)" stroke-width="1"/>
        <circle cx="60"  cy="67" r="5" stroke="rgba(255,120,0,0.24)" stroke-width="1" fill="none"/>
        <circle cx="78"  cy="67" r="5" stroke="rgba(255,120,0,0.24)" stroke-width="1" fill="none"/>
        <circle cx="96"  cy="67" r="5" stroke="rgba(255,120,0,0.24)" stroke-width="1" fill="none"/>
        <rect x="120" y="56" width="220" height="16" rx="3" stroke="rgba(255,100,0,0.14)" stroke-width="1" fill="none"/>
        <line x1="35" y1="114" x2="465" y2="114" stroke="rgba(255,110,0,0.10)" stroke-width="1"/>
        <line x1="60"  y1="99" x2="104" y2="99" stroke="rgba(255,130,0,0.20)" stroke-width="2"/>
        <line x1="122" y1="99" x2="162" y2="99" stroke="rgba(255,100,0,0.14)" stroke-width="2"/>
        <line x1="180" y1="99" x2="220" y2="99" stroke="rgba(255,100,0,0.14)" stroke-width="2"/>
        <line x1="380" y1="99" x2="444" y2="99" stroke="rgba(255,140,0,0.22)" stroke-width="2.5"/>
        <rect x="55" y="128" width="230" height="88" rx="2" stroke="rgba(255,120,0,0.13)" stroke-width="1" fill="none"/>
        <line x1="72" y1="150" x2="244" y2="150" stroke="rgba(255,130,0,0.22)" stroke-width="3"/>
        <line x1="72" y1="164" x2="200" y2="164" stroke="rgba(255,100,0,0.14)" stroke-width="1.5"/>
        <line x1="72" y1="176" x2="220" y2="176" stroke="rgba(255,100,0,0.12)" stroke-width="1.5"/>
        <line x1="72" y1="188" x2="172" y2="188" stroke="rgba(255,100,0,0.12)" stroke-width="1.5"/>
        <rect x="72" y="198" width="62" height="12" rx="2" stroke="rgba(255,140,0,0.24)" stroke-width="1" fill="rgba(255,80,0,0.06)"/>
        <rect x="304" y="128" width="147" height="88" rx="2" stroke="rgba(255,100,0,0.12)" stroke-width="1" fill="rgba(255,80,0,0.03)"/>
        <line x1="304" y1="172" x2="451" y2="172" stroke="rgba(255,90,0,0.08)" stroke-width="1"/>
        <line x1="378" y1="128" x2="378" y2="216" stroke="rgba(255,90,0,0.08)" stroke-width="1"/>
        <rect x="55"  y="236" width="116" height="70" rx="2" stroke="rgba(255,110,0,0.13)" stroke-width="1" fill="none"/>
        <rect x="192" y="236" width="116" height="70" rx="2" stroke="rgba(255,110,0,0.13)" stroke-width="1" fill="none"/>
        <rect x="329" y="236" width="117" height="70" rx="2" stroke="rgba(255,110,0,0.13)" stroke-width="1" fill="none"/>
        <line x1="70"  y1="255" x2="152" y2="255" stroke="rgba(255,110,0,0.16)" stroke-width="1.5"/>
        <line x1="70"  y1="267" x2="138" y2="267" stroke="rgba(255,90,0,0.10)"  stroke-width="1"/>
        <line x1="207" y1="255" x2="289" y2="255" stroke="rgba(255,110,0,0.16)" stroke-width="1.5"/>
        <line x1="207" y1="267" x2="275" y2="267" stroke="rgba(255,90,0,0.10)"  stroke-width="1"/>
        <line x1="344" y1="255" x2="426" y2="255" stroke="rgba(255,110,0,0.16)" stroke-width="1.5"/>
        <line x1="344" y1="267" x2="412" y2="267" stroke="rgba(255,90,0,0.10)"  stroke-width="1"/>
        <line x1="35" y1="326" x2="465" y2="326" stroke="rgba(255,90,0,0.10)" stroke-width="1"/>
        <rect x="35" y="326" width="430" height="44" rx="5" stroke="rgba(255,80,0,0.08)" stroke-width="1" fill="rgba(255,70,0,0.02)"/>
      </svg>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section">
    <div class="container">
      <h2 class="display-font" style="font-size:clamp(2rem,4vw,3rem);margin-bottom:3rem">Comment ça marche ?</h2>
      <ProcessSteps steps={processSteps} />
    </div>
  </section>

  <!-- OFFERS -->
  <section class="section pricing-section" id="formules">
    <div class="container">
      <p class="section-pre mono-font fire-text">— Un site qui reste vivant</p>
      <h2 class="display-font pricing-title">Votre site, suivi dans la durée</h2>
      <div class="fire-divider"></div>
      <p class="pricing-intro">Un budget de départ léger, puis un accompagnement continu : hébergement, maintenance, sécurité et modifications sont inclus dans chaque abonnement.</p>
      <div class="offers-grid">
        {offers.map(o => (
          <div class={`offer-wrapper ${o.highlight ? 'offer-wrapper-highlight' : ''}`}>
            {o.highlight && <div class="offer-badge mono-font">Populaire</div>}
            <div class={`offer-card card ${o.highlight ? 'offer-highlight' : ''}`}>
              <div>
                <p class="offer-kicker mono-font">{o.kicker}</p>
                <h3 class="display-font offer-name">{o.title}</h3>
              </div>
              <div class="offer-price-row">
                <span class="offer-price fire-text display-font">{o.monthly} €</span>
                <span class="offer-period">/ mois</span>
              </div>
              <p class="offer-launch"><strong>{o.launch} €</strong> au lancement</p>
              <p class="offer-purchase">ou {o.purchase.toLocaleString('fr-BE')} € en achat unique</p>
              <ul class="offer-features">
                {o.features.map(f => (
                  <li>
                    <CheckCircleLight width={14} height={14} class="feature-check" />
                    {f}
                  </li>
                ))}
              </ul>
              <button type="button" class={`select-offer ${o.highlight ? 'btn-fire' : 'btn-outline'}`} data-plan={o.id}>Configurer cette formule</button>
            </div>
          </div>
        ))}
      </div>

      <div class="configurator" id="configurateur">
        <div class="configurator-heading">
          <div>
            <p class="section-pre mono-font fire-text">— Estimation instantanée</p>
            <h2 class="display-font">Configurez votre formule</h2>
          </div>
          <p>Choisissez votre base, ajoutez ce qui vous est utile et envoyez-moi directement la configuration.</p>
        </div>

        <form class="quote-form" id="quoteForm" data-pricing={JSON.stringify(offers)}>
          <div class="config-layout">
            <div class="config-main">
              <fieldset class="config-fieldset">
                <legend class="config-legend mono-font">1. Votre formule</legend>
                <div class="plan-picker">
                  {offers.map((offer, index) => (
                    <label class="plan-choice">
                      <input type="radio" name="plan" value={offer.id} checked={index === 1} />
                      <span>
                        <strong class="display-font">{offer.title}</strong>
                        <small>{offer.monthly} €/mois</small>
                      </span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <fieldset class="config-fieldset">
                <legend class="config-legend mono-font">2. Votre mode de paiement</legend>
                <div class="billing-picker">
                  <label class="billing-choice">
                    <input type="radio" name="billing" value="subscription" checked />
                    <span><strong>Abonnement</strong><small>Suivi, maintenance et évolutions inclus</small></span>
                  </label>
                  <label class="billing-choice">
                    <input type="radio" name="billing" value="purchase" />
                    <span><strong>Achat unique</strong><small>Livraison du site, suivi sur devis</small></span>
                  </label>
                </div>
              </fieldset>

              <fieldset class="config-fieldset">
                <legend class="config-legend mono-font">3. Ajustez le contenu</legend>
                {offers.map((offer, index) => (
                  <div class="plan-options" data-options-for={offer.id} hidden={index !== 1}>
                    <div class="quantity-control">
                      <div>
                        <strong>{offer.quantity.label}</strong>
                        <small class="quantity-price" data-monthly={offer.quantity.monthly} data-purchase={offer.quantity.purchase}></small>
                      </div>
                      <div class="stepper">
                        <button type="button" class="stepper-btn" data-step="-1" aria-label={`Retirer un ${offer.quantity.unit}`}>−</button>
                        <input type="number" class="quantity-input" value="0" min="0" max={offer.quantity.max} inputmode="numeric" aria-label={offer.quantity.label} />
                        <button type="button" class="stepper-btn" data-step="1" aria-label={`Ajouter un ${offer.quantity.unit}`}>+</button>
                      </div>
                    </div>

                    <div class="options-list">
                      {offer.options.map(option => (
                        <label class="option-choice">
                          <input type="checkbox" value={option.id} data-setup={option.setup} data-monthly={option.monthly} />
                          <span class="option-copy">
                            <strong>{option.label}</strong>
                            <small>{option.desc}</small>
                          </span>
                          <span class="option-price mono-font">
                            {option.setup > 0 && `+${option.setup} €`}
                            {option.monthly > 0 && <small>+{option.monthly} €/mois</small>}
                          </span>
                        </label>
                      ))}
                    </div>
                  </div>
                ))}
              </fieldset>
            </div>

            <aside class="quote-summary" aria-live="polite">
              <p class="config-legend mono-font">Votre estimation</p>
              <h3 class="display-font" id="summaryPlan">Site 4 pages</h3>
              <div class="summary-prices">
                <div>
                  <span>Au lancement</span>
                  <strong class="display-font" id="summarySetup">250 €</strong>
                </div>
                <div id="monthlySummary">
                  <span>Puis chaque mois</span>
                  <strong class="display-font fire-text" id="summaryMonthly">125 €</strong>
                </div>
              </div>
              <ul class="summary-lines" id="summaryLines"></ul>
              <p class="summary-note" id="summaryNote">Le périmètre et les modalités finales sont confirmés ensemble avant le lancement.</p>

              <div class="quote-contact">
                <label>
                  <span class="mono-font">Nom</span>
                  <input type="text" name="name" autocomplete="name" placeholder="Votre nom" maxlength="100" required />
                </label>
                <label>
                  <span class="mono-font">Email</span>
                  <input type="email" name="email" autocomplete="email" placeholder="vous@exemple.be" maxlength="200" required />
                </label>
                <label>
                  <span class="mono-font">Un mot sur votre projet</span>
                  <textarea name="message" rows="3" maxlength="3000" placeholder="Contexte, délai souhaité, questions…"></textarea>
                </label>
                <label class="website-field" aria-hidden="true">
                  <span>Site web</span>
                  <input type="text" name="website" tabindex="-1" autocomplete="off" />
                </label>
                <button type="submit" class="btn-fire quote-submit">
                  Envoyer cette configuration
                  <PaperPlaneTiltLight width={18} height={18} />
                </button>
                <p class="quote-feedback" id="quoteFeedback" role="status"></p>
                <p class="quote-privacy">En envoyant ce formulaire, vous acceptez que vos données soient utilisées pour répondre à votre demande. <a href="/Mentions-legales">En savoir plus</a>.</p>
              </div>
            </aside>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- TECH -->
  <section class="section">
    <div class="container">
      <h2 class="display-font" style="font-size:clamp(2rem,4vw,3rem);margin-bottom:2rem">Technologies utilisées</h2>
      <div class="tech-grid">
        {techs.map(t => (
          <div class="tech-pill mono-font">{t}</div>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
.page-title { font-size: clamp(4rem, 8vw, 7rem); line-height: 0.9; margin: 1rem 0 1.5rem; }
.page-deco-bg { animation: wf-reveal 1.1s cubic-bezier(0.22,0.61,0.36,1) 0.15s both; }
@keyframes wf-reveal {
  from { opacity: 0; clip-path: inset(0 0 100% 0); }
  to   { opacity: 1; clip-path: inset(0); }
}

.pricing-section { background: var(--dark-card); border-top: 1px solid var(--dark-border); border-bottom: 1px solid var(--dark-border); }
.pricing-title { font-size: clamp(2.4rem, 5vw, 4rem); margin-bottom: 0.5rem; }
.pricing-intro { color: var(--text-secondary); line-height: 1.8; max-width: 720px; }
.offers-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; margin-top: 2.5rem; overflow: visible; }
.offer-wrapper { position: relative; overflow: visible; }
.offer-wrapper:hover .offer-badge { transform: translateY(-4px); box-shadow: 0 8px 20px rgba(255,69,0,0.4); }
.offer-card { position: relative; display: flex; flex-direction: column; gap: 1rem; overflow: visible; height: 100%; padding: 1.75rem; }
.offer-highlight { padding-top: 1.5rem; border-color: var(--ember-1) !important; }
.offer-highlight::before { opacity: 1 !important; }
.offer-badge {
  position: absolute; top: -12px; right: 1.5rem;
  background: var(--gradient-fire); color: #0A0804;
  font-size: 0.7rem; letter-spacing: 0.15em; padding: 0.25rem 0.75rem;
  transition: transform 0.3s ease, box-shadow 0.3s ease; z-index: 999;
}
.offer-kicker { color: var(--text-muted); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; }
.offer-name { font-size: 1.9rem; color: var(--text-primary); margin-top: 0.2rem; }
.offer-price-row { display: flex; align-items: baseline; gap: 0.35rem; margin-top: 0.2rem; }
.offer-price { font-size: clamp(2.7rem, 4vw, 3.5rem); line-height: 0.9; }
.offer-period { color: var(--text-secondary); font-size: 0.85rem; }
.offer-launch { color: var(--text-primary); font-size: 0.9rem; }
.offer-launch strong { color: var(--ember-3); }
.offer-purchase { color: var(--text-muted); font-size: 0.75rem; margin-top: -0.65rem; }
.offer-features { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; flex: 1; }
.offer-features li { font-size: 0.82rem; color: var(--text-secondary); display: flex; align-items: flex-start; gap: 0.5rem; line-height: 1.45; }
.feature-check { color: var(--ember-3); flex-shrink: 0; }
.select-offer { width: 100%; justify-content: center; margin-top: 0.5rem; }

/* Configurateur */
.configurator { margin-top: 6rem; padding-top: 5rem; border-top: 1px solid var(--dark-border-2); scroll-margin-top: 6rem; }
.configurator-heading { display: grid; grid-template-columns: 1fr minmax(280px, 440px); gap: 3rem; align-items: end; margin-bottom: 2.5rem; }
.configurator-heading h2 { font-size: clamp(2.2rem, 4vw, 3.3rem); }
.configurator-heading > p { color: var(--text-secondary); line-height: 1.75; }
.config-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(320px, 390px); gap: 1.5rem; align-items: start; }
.config-main { display: flex; flex-direction: column; gap: 1rem; min-width: 0; }
.config-fieldset { min-width: 0; border: 1px solid var(--dark-border); background: var(--dark-bg); padding: 1.5rem; }
.config-legend { color: var(--ember-3); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; padding: 0 0.4rem; }
.plan-picker { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; }
.plan-choice, .billing-choice { position: relative; cursor: pointer; min-width: 0; }
.plan-choice input, .billing-choice input { position: absolute; opacity: 0; pointer-events: none; }
.plan-choice > span, .billing-choice > span {
  display: flex; flex-direction: column; justify-content: center; gap: 0.25rem;
  min-height: 78px; padding: 0.85rem 1rem; border: 1px solid var(--dark-border);
  background: var(--dark-card); transition: border-color 0.2s, background 0.2s;
}
.plan-choice strong { color: var(--text-primary); font-size: 1.2rem; }
.plan-choice small, .billing-choice small { color: var(--text-muted); font-size: 0.72rem; line-height: 1.4; }
.plan-choice input:checked + span, .billing-choice input:checked + span { border-color: var(--ember-2); background: rgba(255, 100, 0, 0.08); }
.plan-choice input:focus-visible + span, .billing-choice input:focus-visible + span { outline: 2px solid var(--ember-3); outline-offset: 2px; }
.plan-choice input:checked + span small { color: var(--ember-3); }
.billing-picker { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
.billing-choice > span { min-height: 86px; }
.billing-choice strong { font-size: 0.9rem; color: var(--text-primary); }
.quantity-control { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--dark-border); }
.quantity-control > div:first-child { display: flex; flex-direction: column; min-width: 0; }
.quantity-control strong { color: var(--text-primary); font-size: 0.9rem; }
.quantity-control small { color: var(--text-muted); font-size: 0.72rem; }
.stepper { display: grid; grid-template-columns: 44px 52px 44px; flex-shrink: 0; }
.stepper-btn, .quantity-input { height: 44px; border: 1px solid var(--dark-border-2); background: var(--dark-card); color: var(--text-primary); text-align: center; }
.stepper-btn { cursor: pointer; color: var(--ember-3); font-size: 1.15rem; }
.stepper-btn:hover { background: rgba(255, 100, 0, 0.08); }
.quantity-input { width: 52px; border-left: 0; border-right: 0; outline: none; appearance: textfield; }
.quantity-input::-webkit-outer-spin-button, .quantity-input::-webkit-inner-spin-button { appearance: none; margin: 0; }
.options-list { display: flex; flex-direction: column; }
.option-choice { display: flex; align-items: flex-start; gap: 0.8rem; padding: 1rem 0; border-bottom: 1px solid var(--dark-border); cursor: pointer; }
.option-choice:last-child { border-bottom: 0; padding-bottom: 0; }
.option-choice input { width: 18px; height: 18px; margin-top: 0.15rem; accent-color: var(--ember-2); flex-shrink: 0; }
.option-copy { display: flex; flex-direction: column; min-width: 0; flex: 1; }
.option-copy strong { color: var(--text-primary); font-size: 0.88rem; }
.option-copy small { color: var(--text-muted); font-size: 0.72rem; line-height: 1.45; }
.option-price { display: flex; flex-direction: column; align-items: flex-end; color: var(--text-secondary); font-size: 0.72rem; white-space: nowrap; }
.option-price small { color: var(--ember-3); font-size: 0.66rem; }
.quote-summary { position: sticky; top: 6.5rem; background: var(--dark-bg); border: 1px solid rgba(255, 107, 0, 0.35); padding: 1.5rem; min-width: 0; }
.quote-summary::before { content: ''; position: absolute; inset: 0 0 auto; height: 2px; background: var(--gradient-fire); }
.quote-summary h3 { font-size: 1.9rem; margin: 0.5rem 0 1.25rem; }
.summary-prices { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
.summary-prices > div { display: flex; flex-direction: column; padding: 0.85rem; border: 1px solid var(--dark-border); background: var(--dark-card); min-width: 0; }
.summary-prices span { color: var(--text-muted); font-size: 0.68rem; }
.summary-prices strong { color: var(--text-primary); font-size: 1.65rem; line-height: 1.1; }
.summary-prices [hidden] { display: none; }
.summary-lines { list-style: none; display: flex; flex-direction: column; gap: 0.35rem; padding: 1rem 0; border-bottom: 1px solid var(--dark-border); }
.summary-lines li { color: var(--text-secondary); font-size: 0.75rem; display: flex; justify-content: space-between; gap: 1rem; }
.summary-lines li span:last-child { color: var(--text-primary); white-space: nowrap; }
.summary-note { color: var(--text-muted); font-size: 0.68rem; line-height: 1.5; margin: 0.85rem 0 1.25rem; }
.quote-contact { display: flex; flex-direction: column; gap: 0.75rem; }
.quote-contact label { display: flex; flex-direction: column; gap: 0.3rem; }
.quote-contact label > span { color: var(--ember-3); font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; }
.quote-contact input, .quote-contact textarea {
  width: 100%; border: 1px solid var(--dark-border); background: var(--dark-card); color: var(--text-primary);
  padding: 0.75rem 0.8rem; outline: none; resize: vertical; font-family: 'DM Sans', sans-serif; font-size: 0.85rem;
}
.quote-contact input:focus, .quote-contact textarea:focus { border-color: var(--ember-2); }
.quote-contact input::placeholder, .quote-contact textarea::placeholder { color: var(--text-muted); }
.website-field { position: absolute !important; left: -10000px !important; width: 1px; height: 1px; overflow: hidden; }
.quote-submit { justify-content: center; width: 100%; margin-top: 0.25rem; }
.quote-submit:disabled { opacity: 0.55; cursor: wait; }
.quote-feedback { display: none; padding: 0.7rem; border: 1px solid var(--dark-border); font-size: 0.75rem; line-height: 1.45; }
.quote-feedback.visible { display: block; }
.quote-feedback.success { color: #86efac; border-color: rgba(34, 197, 94, 0.35); background: rgba(34, 197, 94, 0.06); }
.quote-feedback.error { color: #fca5a5; border-color: rgba(239, 68, 68, 0.35); background: rgba(239, 68, 68, 0.06); }
.quote-privacy { color: var(--text-muted); font-size: 0.65rem; line-height: 1.45; text-align: center; }
.quote-privacy a { color: var(--ember-3); }

.tech-grid { display: flex; flex-wrap: wrap; gap: 0.75rem; }
.tech-pill {
  padding: 0.5rem 1.25rem; border: 1px solid var(--dark-border);
  color: var(--text-secondary); font-size: 0.85rem; letter-spacing: 0.05em;
  transition: border-color 0.2s, color 0.2s;
}
.tech-pill:hover { border-color: var(--ember-2); color: var(--ember-3); }

@media (max-width: 1000px) {
  .offers-grid { grid-template-columns: 1fr; }
  .offer-card { display: grid; grid-template-columns: 1fr 1fr; column-gap: 2rem; }
  .offer-features { grid-column: 2; grid-row: 1 / span 4; }
  .select-offer { grid-column: 1 / -1; }
  .config-layout { grid-template-columns: 1fr; }
  .quote-summary { position: static; }
}

@media (max-width: 768px) {
  .configurator { margin-top: 4.5rem; padding-top: 4rem; }
  .configurator-heading { grid-template-columns: 1fr; gap: 1rem; }
  .plan-picker { grid-template-columns: 1fr; }
  .plan-choice > span { min-height: 64px; }
  .billing-picker { grid-template-columns: 1fr; }
}

@media (max-width: 560px) {
  .offers-grid { gap: 1rem; }
  .offer-card { display: flex; padding: 1.35rem; gap: 0.9rem; }
  .offer-features { grid-column: auto; grid-row: auto; }
  .offer-price { font-size: 3rem; }
  .config-fieldset, .quote-summary { padding: 1rem; }
  .quantity-control { align-items: flex-start; flex-direction: column; }
  .stepper { width: 100%; grid-template-columns: 44px 1fr 44px; }
  .quantity-input { width: 100%; }
  .option-choice { gap: 0.6rem; }
  .option-price { font-family: 'DM Sans', sans-serif; }
  .summary-prices { gap: 0.5rem; }
  .summary-prices > div { padding: 0.7rem; }
  .summary-prices strong { font-size: 1.4rem; }
  .tech-grid { gap: 0.5rem; }
  .tech-pill { font-size: 0.72rem; padding: 0.4rem 0.7rem; }
}
</style>

<script>
const quoteForm = document.getElementById('quoteForm') as HTMLFormElement | null;

if (quoteForm) {
  type PriceOption = { id: string; label: string; setup: number; monthly: number };
  type Offer = {
    id: string; title: string; launch: number; monthly: number; purchase: number;
    quantity: { label: string; unit: string; monthly: number; purchase: number; max: number };
    options: PriceOption[];
  };

  const pricing = JSON.parse(quoteForm.dataset.pricing || '[]') as Offer[];
  const summaryPlan = document.getElementById('summaryPlan');
  const summarySetup = document.getElementById('summarySetup');
  const summaryMonthly = document.getElementById('summaryMonthly');
  const monthlySummary = document.getElementById('monthlySummary');
  const summaryLines = document.getElementById('summaryLines');
  const summaryNote = document.getElementById('summaryNote');
  const feedback = document.getElementById('quoteFeedback');
  const submitButton = quoteForm.querySelector<HTMLButtonElement>('.quote-submit');
  const euro = new Intl.NumberFormat('fr-BE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });

  const selectedValue = (name: string) => quoteForm.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value || '';
  const selectedOffer = () => pricing.find((offer) => offer.id === selectedValue('plan')) || pricing[1] || pricing[0];
  const activePanel = () => quoteForm.querySelector<HTMLElement>(`.plan-options[data-options-for="${selectedOffer().id}"]`);

  function renderPricing() {
    const offer = selectedOffer();
    const billing = selectedValue('billing');

    quoteForm.querySelectorAll<HTMLElement>('.plan-options').forEach((panel) => {
      panel.hidden = panel.dataset.optionsFor !== offer.id;
    });

    const panel = activePanel();
    const quantityInput = panel?.querySelector<HTMLInputElement>('.quantity-input');
    const quantity = Math.max(0, Math.min(Number(quantityInput?.max || offer.quantity.max), Number(quantityInput?.value || 0)));
    if (quantityInput) quantityInput.value = String(quantity);

    let setup = billing === 'subscription' ? offer.launch : offer.purchase;
    let monthly = billing === 'subscription' ? offer.monthly : 0;
    const lines: { label: string; price: string }[] = [
      { label: billing === 'subscription' ? `Lancement — ${offer.title}` : `Achat — ${offer.title}`, price: euro.format(setup) },
    ];

    const quantityPrice = panel?.querySelector<HTMLElement>('.quantity-price');
    if (quantityPrice) {
      quantityPrice.textContent = billing === 'subscription'
        ? `+${euro.format(offer.quantity.monthly)}/mois par ${offer.quantity.unit}`
        : `+${euro.format(offer.quantity.purchase)} par ${offer.quantity.unit}`;
    }

    if (quantity > 0) {
      if (billing === 'subscription') {
        monthly += quantity * offer.quantity.monthly;
        lines.push({ label: `${offer.quantity.label} × ${quantity}`, price: `+${euro.format(quantity * offer.quantity.monthly)}/mois` });
      } else {
        setup += quantity * offer.quantity.purchase;
        lines.push({ label: `${offer.quantity.label} × ${quantity}`, price: `+${euro.format(quantity * offer.quantity.purchase)}` });
      }
    }

    const selectedOptions: string[] = [];
    panel?.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked').forEach((input) => {
      const option = offer.options.find((item) => item.id === input.value);
      if (!option) return;
      setup += option.setup;
      monthly += option.monthly;
      selectedOptions.push(option.label);
      const parts = [option.setup ? `+${euro.format(option.setup)}` : '', option.monthly ? `+${euro.format(option.monthly)}/mois` : ''].filter(Boolean);
      lines.push({ label: option.label, price: parts.join(' · ') });
    });

    if (summaryPlan) summaryPlan.textContent = offer.title;
    if (summarySetup) summarySetup.textContent = euro.format(setup);
    if (summaryMonthly) summaryMonthly.textContent = euro.format(monthly);
    if (monthlySummary) monthlySummary.hidden = monthly === 0;
    if (summaryLines) summaryLines.innerHTML = lines.map((line) => `<li><span>${line.label}</span><span>${line.price}</span></li>`).join('');
    if (summaryNote) summaryNote.textContent = billing === 'subscription'
      ? 'Le périmètre et les modalités finales sont confirmés ensemble avant le lancement.'
      : 'L’achat unique n’inclut pas le suivi mensuel. Hébergement et maintenance peuvent être ajoutés sur devis.';

    quoteForm.dataset.summary = JSON.stringify({
      plan: offer.title,
      billing: billing === 'subscription' ? 'Abonnement' : 'Achat unique',
      quantityLabel: offer.quantity.label,
      quantity,
      options: selectedOptions,
      setup,
      monthly,
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.select-offer').forEach((button) => {
    button.addEventListener('click', () => {
      const radio = quoteForm.querySelector<HTMLInputElement>(`input[name="plan"][value="${button.dataset.plan}"]`);
      if (radio) radio.checked = true;
      renderPricing();
      document.getElementById('configurateur')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  quoteForm.addEventListener('change', renderPricing);
  quoteForm.addEventListener('input', (event) => {
    if ((event.target as HTMLElement).classList.contains('quantity-input')) renderPricing();
  });

  quoteForm.querySelectorAll<HTMLButtonElement>('.stepper-btn').forEach((button) => {
    button.addEventListener('click', () => {
      const input = button.closest('.stepper')?.querySelector<HTMLInputElement>('.quantity-input');
      if (!input) return;
      const next = Number(input.value || 0) + Number(button.dataset.step || 0);
      input.value = String(Math.max(Number(input.min), Math.min(Number(input.max), next)));
      renderPricing();
    });
  });

  quoteForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!submitButton || !quoteForm.reportValidity()) return;

    const formData = new FormData(quoteForm);
    const originalHtml = submitButton.innerHTML;
    submitButton.disabled = true;
    submitButton.textContent = 'Envoi en cours…';
    feedback?.classList.remove('visible', 'success', 'error');

    try {
      const response = await fetch('/.netlify/functions/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          type: 'quote',
          name: formData.get('name'),
          email: formData.get('email'),
          message: formData.get('message'),
          website: formData.get('website'),
          quote: JSON.parse(quoteForm.dataset.summary || '{}'),
        }),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || 'Impossible d’envoyer la demande.');

      if (feedback) {
        feedback.textContent = 'Configuration envoyée ! Je reviens vers vous sous 24 h.';
        feedback.classList.add('visible', 'success');
      }
      quoteForm.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
    } catch (error) {
      if (feedback) {
        feedback.textContent = error instanceof Error ? error.message : 'Une erreur est survenue. Écrivez-moi à contact@enkotech.be.';
        feedback.classList.add('visible', 'error');
      }
    } finally {
      submitButton.disabled = false;
      submitButton.innerHTML = originalHtml;
    }
  });

  renderPricing();
}
</script>
