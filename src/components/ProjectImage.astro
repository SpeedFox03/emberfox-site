---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { source: string; alt: string; sizes?: string; loading?: 'lazy' | 'eager'; class?: string; }
const { source, alt, sizes = '(max-width: 768px) 100vw, 50vw', loading = 'lazy', class: className } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../images/projects/moment-d-art/*.png', { eager: true });
const filename = source.split('/').pop();
const image = images[`../images/projects/moment-d-art/${filename}`]?.default;
if (!image) throw new Error(`Missing project image: ${filename}`);
---
<Image src={image} alt={alt} width={1280} widths={[480, 768, 1280]} sizes={sizes} format="webp" quality={80} loading={loading} decoding="async" class={className} />
